# 复制本文件为 .env 后填入实际值。.env 已在 .gitignore 中，不会被提交。
# 已设置的系统环境变量优先于 .env 中的值。

# 通义千问 API Key（用于 AI 总结，纯转写不需要）
# 获取：https://dashscope.console.aliyun.com/
DASHSCOPE_API_KEY=

# FunASR 模型缓存目录（可选，用于把约 500MB 模型迁出系统盘）
# MODELSCOPE_CACHE=E:\models\modelscope

# 禁用 Gradio 遥测，避免启动时连接超时（可选）
# GRADIO_ANALYTICS_ENABLED=False
